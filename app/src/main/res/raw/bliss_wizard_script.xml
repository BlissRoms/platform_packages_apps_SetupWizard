<WizardScript xmlns:wizard="http://schemas.android.com/apk/res/com.google.android.setupwizard"
    wizard:firstAction="bluetooth_setup">

    <WizardAction
        id="bluetooth_setup"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.BLISS_BLUETOOTH_SETUP;end">
        <result wizard:action="welcome" />
    </WizardAction>

    <WizardAction
        id="welcome"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.BLISS_WELCOME;end">
        <result
            wizard:name="skip"
            wizard:resultCode="1" />
        <result wizard:action="locale" />
    </WizardAction>

    <WizardAction
        id="locale"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.BLISS_LOCALE;end">
        <result wizard:action="sim_missing" />
    </WizardAction>

    <WizardAction
        id="sim_missing"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.BLISS_SIM_MISSING;end">
        <result wizard:action="network_setup" />
    </WizardAction>

    <WizardAction
        id="network_setup"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.BLISS_NETWORK_SETUP;end">
        <result wizard:action="datetime" />
    </WizardAction>

    <WizardAction
        id="datetime"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.BLISS_DATETIME;end">
        <result wizard:action="restore" />
    </WizardAction>

    <WizardAction
        id="restore"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.BLISS_RESTORE_BACKUP;end">
        <result wizard:action="location_settings" />
    </WizardAction>

    <WizardAction
        id="location_settings"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.BLISS_LOCATION_SETTINGS;end">
        <result wizard:action="device_specific" />
    </WizardAction>

    <WizardAction
        id="device_specific"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.DEVICE_SPECIFIC;end">
        <result wizard:action="recovery_update" />
    </WizardAction>

    <WizardAction
        id="recovery_update"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.BLISS_RECOVERY_UPDATE;end">
        <result wizard:action="bliss_settings" />
    </WizardAction>

    <WizardAction
        id="bliss_settings"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.BLISS_SETTINGS;end">
        <result wizard:action="biometric_settings" />
    </WizardAction>

    <WizardAction
        id="biometric_settings"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.BLISS_BIOMETRIC_SETTINGS;end">
        <result wizard:action="lockscreen_settings" />
    </WizardAction>

    <WizardAction
        id="lockscreen_settings"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.BLISS_LOCKSCREEN_SETTINGS;end">
        <result wizard:action="theme_settings" />
    </WizardAction>

    <WizardAction
        id="theme_settings"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.THEME_SETTINGS;end">
        <result wizard:action="navigation_settings" />
    </WizardAction>

    <WizardAction
        id="navigation_settings"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.NAVIGATION_SETTINGS;end">
        <result wizard:action="finish" />
    </WizardAction>

    <WizardAction
        id="finish"
        wizard:uri="intent:#Intent;action=org.blissroms.setupwizard.BLISS_SETUP_COMPLETE;end" />

</WizardScript>
